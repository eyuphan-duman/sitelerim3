rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────── Yardımcı fonksiyonlar ─────────
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        request.auth.token.email != null && (
          request.auth.token.email.lower() == 'furkan@furkanmanav.com' ||
          // Bu adres Firebase'de kayıtlı olmadığından yalnızca doğrulanmış e-postayla (ör. Google ile giriş) kabul edilir;
          // aksi halde biri bu adresle şifreli hesap açıp yönetici olabilirdi
          (request.auth.token.email.lower() == 'pskfurkan.manav@gmail.com' && request.auth.token.email_verified == true)
        );
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function notBanned() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        myProfile().get('isBanned', false) != true ||
        // Süreli ban: bitiş zamanı geçmişse artık banlı sayılmaz
        (myProfile().get('banUntil', null) != null && myProfile().get('banUntil', null) < request.time);
    }

    function isEmailVerified() {
      return isAdmin() || request.auth.token.email_verified == true;
    }

    function isVerifiedPsychologist() {
      return myProfile().get('isPsychologist', false) == true &&
        myProfile().get('psychologistStatus', 'approved') == 'approved';
    }

    // 560 bayt ~ en kötü ihtimalle 140 çok baytlı (örn. Türkçe) karakter için güvenli üst sınır;
    // asıl 140 karakter sınırı istemci tarafında uygulanır, burası kötüye kullanıma karşı yedek sınırdır.
    function withinPostLimits() {
      return request.resource.data.get('body', '').size() <= 560 &&
        request.resource.data.get('replyPolicy', 'everyone') in ['everyone', 'followers', 'psychologists', 'nobody'] &&
        (request.resource.data.get('imageUrl', '') == '' ||
          isVerifiedPsychologist() ||
          myProfile().get('photoUploadsUsed', 0) < 1);
    }

    // ── İsimsiz paylaşım ──
    // İsimsiz gönderide uid = 'anonymous'; gerçek sahibi anon_owners/{postId} kaydındadır.
    function anonOwnerOf(postId) {
      return get(/databases/$(database)/documents/anon_owners/$(postId)).data.uid;
    }

    // Yeni isimsiz gönderi: aynı toplu yazımda sahiplik kaydı da oluşturulmalı
    function validAnonPost(postId) {
      return request.resource.data.uid == 'anonymous' &&
        request.resource.data.isAnonymous == true &&
        request.resource.data.get('authorIsPsychologist', false) == false &&
        request.resource.data.get('authorUsername', '') == '' &&
        request.resource.data.get('replyPolicy', 'everyone') != 'followers' &&
        getAfter(/databases/$(database)/documents/anon_owners/$(postId)).data.uid == request.auth.uid;
    }

    // İki kişiden biri diğerini engellemiş mi?
    function blockedBetween(a, b) {
      return exists(/databases/$(database)/documents/blocks/$(a + '_' + b)) ||
        exists(/databases/$(database)/documents/blocks/$(b + '_' + a));
    }

    // Gönderi sahibinin seçtiği yanıt iznine uyuluyor mu?
    function canReplyTo(postId) {
      let post = get(/databases/$(database)/documents/forum/$(postId)).data;
      let policy = post.get('replyPolicy', 'everyone');
      return (post.uid == request.auth.uid || !blockedBetween(request.auth.uid, post.uid)) && (
        policy == 'everyone' ||
        post.uid == request.auth.uid ||
        isAdmin() ||
        (policy == 'psychologists' && isVerifiedPsychologist()) ||
        (policy == 'followers' &&
          exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + post.uid))));
    }

    // ── Spam koruması (hız sınırı) ──
    // Her gönderi, yorum ve yeniden paylaşım, aynı toplu yazımda rate_limits/{uid} kaydını günceller.
    // Kayıtta türe göre (post | comment | repost) şu alanlar tutulur:
    //   <tür>At    son paylaşım zamanı
    //   <tür>Win   bir saatlik pencerenin başlangıcı
    //   <tür>Count pencere içindeki paylaşım sayısı
    //   <tür>Text  son paylaşılan metin
    //   <tür>Ref   son oluşturulan belgenin yolu
    function rlPath() {
      return /databases/$(database)/documents/rate_limits/$(request.auth.uid);
    }

    // Son paylaşımdan bu yana en az gapSec saniye geçmeli. Bir saatte en fazla perHour paylaşım yapılabilir.
    // Aynı metin arka arkaya paylaşılamaz (text boşsa, örneğin yalnız fotoğraf ya da yeniden paylaşımsa, denetlenmez).
    function rateOk(kind, gapSec, perHour, text) {
      let after = getAfter(rlPath()).data;
      let before = exists(rlPath()) ? get(rlPath()).data : {};
      let last = before.get(kind + 'At', null);
      let win = before.get(kind + 'Win', null);
      return isAdmin() || (
        after.get(kind + 'At', null) == request.time &&
        (last == null || last < request.time - duration.value(gapSec, 's')) &&
        after.get(kind + 'Text', '') == text &&
        (text == '' || before.get(kind + 'Text', '') != text) && (
          // Pencere sürüyor: sayaç bir artar ve sınırı geçemez
          (win != null && win > request.time - duration.value(1, 'h') &&
            after.get(kind + 'Win', null) == win &&
            after.get(kind + 'Count', 0) == before.get(kind + 'Count', 0) + 1 &&
            after.get(kind + 'Count', 0) <= perHour) ||
          // Yeni pencere (cihaz saati kaymalarına karşı 50 dakikadan sonra açılabilir)
          ((win == null || win < request.time - duration.value(50, 'm')) &&
            after.get(kind + 'Win', null) == request.time &&
            after.get(kind + 'Count', 0) == 1)
        )
      );
    }

    function rlFieldsChanged(kind) {
      let d = request.resource.data;
      let old = resource == null ? {} : resource.data;
      return d.get(kind + 'At', null) != old.get(kind + 'At', null) ||
        d.get(kind + 'Win', null) != old.get(kind + 'Win', null) ||
        d.get(kind + 'Count', 0) != old.get(kind + 'Count', 0) ||
        d.get(kind + 'Text', '') != old.get(kind + 'Text', '') ||
        d.get(kind + 'Ref', '') != old.get(kind + 'Ref', '');
    }

    // Sayaç yalnızca o türden yeni bir belge aynı yazımda oluşturulurken değişebilir
    // (tek başına sıfırlanıp sınır aşılamaz)
    function rlKindOk(kind, isRepost, isComment) {
      let ref = request.resource.data.get(kind + 'Ref', '');
      let p = path('/databases/' + database + '/documents/' + ref);
      return !rlFieldsChanged(kind) || (
        request.resource.data.get(kind + 'At', null) == request.time &&
        ref is string &&
        (isComment
          ? ref.matches('forum/[^/]+/comments/[^/]+')
          : (ref.matches('forum/[^/]+') && getAfter(p).data.get('isRepost', false) == isRepost)) &&
        existsAfter(p) && !exists(p)
      );
    }

    function withinCommentLimits() {
      return request.resource.data.get('text', '').size() <= 560 &&
        (request.resource.data.get('imageUrl', '') == '' ||
          isVerifiedPsychologist() ||
          myProfile().get('photoUploadsUsed', 0) < 1);
    }

    // Psikolog rozeti yalnızca onaylı psikologlar tarafından taşınabilir
    function validPsychBadge() {
      return request.resource.data.get('authorIsPsychologist', false) == false ||
        isAdmin() ||
        (myProfile().get('isPsychologist', false) == true &&
         myProfile().get('psychologistStatus', 'approved') == 'approved');
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Bir map alanında yalnızca kullanıcının kendi uid anahtarı değişebilir
    function onlyOwnKeyIn(field) {
      return request.resource.data.get(field, {})
        .diff(resource.data.get(field, {}))
        .affectedKeys().hasOnly([request.auth.uid]);
    }

    function counterStep(field, allowed) {
      return (request.resource.data.get(field, 0) - resource.data.get(field, 0)) in allowed;
    }

    // İçerik sahibinin bile doğrudan değiştiremeyeceği alanlar: etkileşimler yalnızca validInteraction()
    // ile (herkes yalnızca kendi anahtarını) değişir; tarih ve tür sabittir. Böylece sahte beğeni ya da
    // tarih oynatarak puan/sıralama hilesi yapılamaz.
    function protectedContentKeys() {
      return ['reactionsData', 'repostsData', 'bookmarksData', 'commentCount', 'viewsCount',
        'createdAt', 'isRepost', 'originalPostId', 'isAnonymous'];
    }

    // Başkasının gönderisi/yorumu üzerinde izin verilen etkileşimler:
    // beğeni, repost, kaydetme, yorum sayacı (±1), görüntülenme (+1)
    function validInteraction() {
      return changedKeys().hasOnly(['reactionsData', 'repostsData', 'bookmarksData', 'commentCount', 'viewsCount']) &&
        onlyOwnKeyIn('reactionsData') &&
        onlyOwnKeyIn('repostsData') &&
        onlyOwnKeyIn('bookmarksData') &&
        counterStep('commentCount', [-1, 0, 1]) &&
        counterStep('viewsCount', [0, 1]);
    }

    // ───────── Kullanıcılar ─────────
    // Kullanıcının kendisinin değiştiremeyeceği yetki alanları
    function protectedUserKeys() {
      return ['isPsychologist', 'psychologistStatus', 'role', 'isBanned', 'reviewedAt', 'uid',
        'banUntil', 'banDuration', 'bannedAt', 'photoUploadsUsed', 'frozenByAdmin'];
    }

    // Kullanıcı yalnızca "psikolog başvurusu beklemede" durumuna geçebilir
    function selfPsychApplication() {
      return request.resource.data.get('isPsychologist', false) == false &&
        request.resource.data.get('psychologistStatus', 'none') in ['pending', 'none'] &&
        request.resource.data.get('role', 'member') in ['member', 'psychologist_pending'];
    }

    // Herkese açık profilde e-posta, tam ad, doğum tarihi ve mezun belgesi tutulmaz
    // (bkz. private_users ve psychologist_applications)
    function noPrivateFields() {
      return !request.resource.data.keys().hasAny(['email', 'fullName', 'birthDate', 'diplomaUrl']);
    }

    match /users/{uid} {
      // Forum ve profil için herkese açık (yalnızca açık profil bilgileri)
      allow read: if true;

      allow create: if isAdmin() || (
        isSelf(uid) &&
        noPrivateFields() &&
        request.resource.data.get('isBanned', false) == false &&
        selfPsychApplication()
      );

      allow update: if isAdmin() || (
        isSelf(uid) && noPrivateFields() &&
        // Yöneticinin dondurduğu hesabın dondurma durumu kullanıcı tarafından değiştirilemez
        !(resource.data.get('frozenByAdmin', false) == true && changedKeys().hasAny(['isFrozen', 'frozenAt'])) && (
          !changedKeys().hasAny(protectedUserKeys()) ||
          (!changedKeys().hasAny(['isBanned', 'uid', 'reviewedAt']) && selfPsychApplication()) ||
          // Fotoğraf hakkı sayacı yalnızca tek tek ve yukarı yönde kendi kendine güncellenebilir
          (changedKeys().hasOnly(['photoUploadsUsed']) && counterStep('photoUploadsUsed', [1]))
        )
      );

      allow delete: if isAdmin();

      match /bookmarks/{postId} {
        allow read, write: if isSelf(uid) || isAdmin();
      }
    }

    // Gizli üye bilgileri: yalnızca üyenin kendisi ve admin
    match /private_users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isAdmin() || (
        isSelf(uid) &&
        request.resource.data.keys().hasOnly(['email', 'fullName', 'birthDate', 'updatedAt']) &&
        request.resource.data.get('email', '') == request.auth.token.get('email', '').lower()
      );
      allow delete: if isAdmin();
    }

    // ───────── Forum ─────────
    match /forum/{postId} {
      allow read: if true;

      allow create: if signedIn() &&
        ((request.resource.data.uid == request.auth.uid && request.resource.data.get('isAnonymous', false) == false) ||
          validAnonPost(postId)) &&
        notBanned() &&
        isEmailVerified() &&
        withinPostLimits() &&
        validPsychBadge() &&
        (request.resource.data.get('isRepost', false) == true
          ? rateOk('repost', 3, 60, '')
          : rateOk('post', 30, 10, request.resource.data.get('body', '')));

      allow update: if isAdmin() ||
        (signedIn() && resource.data.uid == request.auth.uid &&
          request.resource.data.uid == resource.data.uid &&
          !changedKeys().hasAny(protectedContentKeys()) &&
          (!changedKeys().hasAny(['authorIsPsychologist']) || validPsychBadge())) ||
        (signedIn() && validInteraction()) ||
        // Ziyaretçilerin görüntülenme sayacı
        (changedKeys().hasOnly(['viewsCount']) && counterStep('viewsCount', [1]));

      allow delete: if isAdmin() ||
        (signedIn() && resource.data.uid == request.auth.uid) ||
        (signedIn() && resource.data.uid == 'anonymous' && anonOwnerOf(postId) == request.auth.uid);

      match /comments/{commentId} {
        allow read: if true;

        allow create: if signedIn() &&
          notBanned() &&
          isEmailVerified() &&
          withinCommentLimits() &&
          validPsychBadge() &&
          rateOk('comment', 10, 40, request.resource.data.get('text', '')) && (
            (request.resource.data.uid == request.auth.uid &&
              request.resource.data.get('isAnonymous', false) == false &&
              canReplyTo(postId)) ||
            // İsimsiz gönderinin sahibi kendi gönderisine isimsiz yanıt verir
            (request.resource.data.uid == 'anonymous' &&
              request.resource.data.isAnonymous == true &&
              request.resource.data.get('authorIsPsychologist', false) == false &&
              anonOwnerOf(postId) == request.auth.uid)
          );

        allow update: if isAdmin() ||
          (signedIn() && resource.data.uid == request.auth.uid &&
            request.resource.data.uid == resource.data.uid &&
            !changedKeys().hasAny(protectedContentKeys()) &&
            !changedKeys().hasAny(['authorIsPsychologist'])) ||
          (signedIn() && validInteraction());

        // Yorum sahibi, gönderi sahibi veya admin silebilir
        allow delete: if isAdmin() ||
          (signedIn() && (
            resource.data.uid == request.auth.uid ||
            get(/databases/$(database)/documents/forum/$(postId)).data.uid == request.auth.uid ||
            (get(/databases/$(database)/documents/forum/$(postId)).data.uid == 'anonymous' &&
              anonOwnerOf(postId) == request.auth.uid)
          ));
      }
    }

    // ───────── Spam koruması: hız sınırı kayıtları ─────────
    // Yalnızca sahibi okur ve yalnızca yeni bir paylaşımla birlikte güncellenebilir; silinemez.
    match /rate_limits/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isSelf(uid) &&
        request.resource.data.keys().hasOnly([
          'postAt', 'postWin', 'postCount', 'postText', 'postRef',
          'commentAt', 'commentWin', 'commentCount', 'commentText', 'commentRef',
          'repostAt', 'repostWin', 'repostCount', 'repostText', 'repostRef']) &&
        rlKindOk('post', false, false) &&
        rlKindOk('comment', false, true) &&
        rlKindOk('repost', true, false);
      allow delete: if isAdmin();
    }

    // ───────── İsimsiz gönderi sahiplikleri ─────────
    // Yalnızca sahibi ve yönetici okur. Yalnızca gönderiyle aynı anda oluşturulabilir.
    match /anon_owners/{postId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['uid', 'createdAt']) &&
        request.resource.data.uid == request.auth.uid &&
        !exists(/databases/$(database)/documents/forum/$(postId)) &&
        getAfter(/databases/$(database)/documents/forum/$(postId)).data.uid == 'anonymous';
      allow update, delete: if false;
    }

    // ───────── Takip ─────────
    match /follows/{followId} {
      allow read: if true;
      allow create: if signedIn() &&
        request.resource.data.followerId == request.auth.uid &&
        followId == request.auth.uid + '_' + request.resource.data.followingId &&
        !blockedBetween(request.auth.uid, request.resource.data.followingId);
      // Takip eden takibi bırakabilir, takip edilen takipçiyi çıkarabilir
      allow delete: if isAdmin() ||
        (signedIn() && (resource.data.followerId == request.auth.uid ||
                        resource.data.followingId == request.auth.uid));
      allow update: if false;
    }

    // ───────── Engellemeler ─────────
    // Yalnızca engelleyen ve engellenen görebilir; yalnızca engelleyen kaldırabilir
    match /blocks/{blockId} {
      allow read: if signedIn() &&
        (resource.data.blockerId == request.auth.uid || resource.data.blockedId == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['blockerId', 'blockedId', 'createdAt']) &&
        request.resource.data.blockerId == request.auth.uid &&
        request.resource.data.blockedId is string &&
        request.resource.data.blockedId != request.auth.uid &&
        blockId == request.auth.uid + '_' + request.resource.data.blockedId;
      allow delete: if isAdmin() || (signedIn() && resource.data.blockerId == request.auth.uid);
      allow update: if false;
    }

    // ───────── Anlık bildirim cihaz anahtarları ─────────
    // Belge kimliği cihazın FCM anahtarıdır. Cihazda hesap değişince anahtar yeni hesaba yazılır;
    // anahtarları yalnızca sunucu okur (bildirim gönderirken).
    match /push_tokens/{token} {
      allow read: if false;
      allow create, update: if signedIn() &&
        request.resource.data.keys().hasOnly(['uid', 'platform', 'updatedAt']) &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ───────── Bildirimler ─────────
    // Bildirim metni türüne göre sabittir; gönderen adı, kullanıcı adı ve fotoğrafı kişinin kendi
    // profiliyle aynı olmalıdır. Böylece başkası adına ya da serbest metinli (oltalama) bildirim yazılamaz.
    function notificationMessages() {
      return {
        'reaction': ['gönderini beğendi.'],
        'repost': ['gönderini yeniden paylaştı.'],
        'comment': ['gönderine yanıt verdi.', 'yanıtına yanıt verdi.'],
        'mention': ['senden bahsetti.'],
        'follow': ['seni takip etmeye başladı.']
      };
    }

    function validNotification() {
      let d = request.resource.data;
      let me = myProfile();
      return d.keys().hasOnly(['toUid', 'fromUid', 'fromUser', 'fromUsername', 'fromPhotoURL', 'type', 'message',
          'postId', 'postTitle', 'read', 'createdAt']) &&
        d.toUid is string && d.toUid != '' &&
        d.type in notificationMessages() &&
        d.message in notificationMessages()[d.type] &&
        d.get('read', false) == false &&
        d.get('postTitle', '') is string && d.get('postTitle', '').size() <= 80 &&
        d.get('fromUser', '') in [me.get('displayName', ''), 'Kullanıcı'] &&
        d.get('fromUsername', '') == me.get('username', '') &&
        d.get('fromPhotoURL', '') in ['', me.get('photoURL', '')];
    }

    match /notifications/{notifId} {
      allow read: if isAdmin() || (signedIn() && resource.data.toUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid &&
        !blockedBetween(request.auth.uid, request.resource.data.get('toUid', '')) &&
        validNotification();
      allow update: if signedIn() && resource.data.toUid == request.auth.uid &&
        changedKeys().hasOnly(['read']);
      allow delete: if isAdmin() ||
        (signedIn() && (resource.data.toUid == request.auth.uid ||
                        resource.data.fromUid == request.auth.uid));
    }

    // ───────── Şikayetler ─────────
    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.status == 'pending' &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    // ───────── İletişim mesajları ─────────
    // Herkes gönderebilir, yalnızca admin okuyabilir/yönetebilir
    match /messages/{messageId} {
      allow create: if request.resource.data.status == 'unread' &&
        request.resource.data.get('message', '') is string &&
        request.resource.data.get('message', '').size() <= 5000;
      allow read, update, delete: if isAdmin();
    }

    // ───────── Psikolog başvuruları ─────────
    match /psychologist_applications/{uid} {
      allow read: if isAdmin() || isSelf(uid);
      allow create, update: if isAdmin() ||
        (isSelf(uid) && request.resource.data.get('status', 'pending') == 'pending');
      allow delete: if isAdmin();
    }

    // ───────── Randevular ─────────
    match /appointments/{id} {
      allow read, write: if isAdmin();
    }

    // ───────── Site içeriği (yalnızca admin yazabilir) ─────────
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reels/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /posts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /faq/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn() &&
          request.resource.data.userId == request.auth.uid &&
          notBanned();
        allow update: if false;
        allow delete: if isAdmin() ||
          (signedIn() && resource.data.userId == request.auth.uid);
      }
    }

    // Tanımlanmamış her şey kapalı
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
